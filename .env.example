# Jackery Monitor — environment file for Synology / Linux deployment.
#
# Copy this file to `.env` next to docker-compose.yml. `.env` is gitignored
# so anything you put here stays on the NAS.
#
#   cp .env.example .env
#   docker compose up -d
#
# ============================================================
# CREDENTIALS — sign in via the dashboard, not env vars
# ============================================================
# Open http://<nas>:8000 after the stack is up; the UI will prompt you for
# your Jackery email + password. They are encrypted (AES-256-GCM) and saved
# inside the `jackery-data` Docker volume — never written to this file.
#
# Only set JACKERY_EMAIL / JACKERY_PASSWORD below if you intentionally want
# to PIN credentials via env (e.g. CI). When pinned, the UI sign-in / sign-out
# flow is locked. Leave both blank to use the UI flow (recommended).
#
# JACKERY_EMAIL=
# JACKERY_PASSWORD=

# Region: US | EU | CN  (default US). The cloud picks a different host per region.
JACKERY_REGION=US

# ----- OPTIONAL: dashboard port on the NAS -----
# Set this if 8000 is already used on your Synology (DSM, other apps, etc.).
JACKERY_HTTP_PORT=8000
