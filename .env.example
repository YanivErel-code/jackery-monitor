# Jackery Monitor — environment file for the Synology / Linux deployment.
#
# Copy this file to `.env` (next to docker-compose.yml) and fill it in.
# `.env` is gitignored so your credentials stay on the NAS.
#
#   cp .env.example .env
#   nano .env
#   docker compose --profile synology up -d --build
#
# These are read by docker compose only when you use --profile synology.
# On macOS (--profile mac) the bridge still reads from the host Keychain.

# ----- REQUIRED: Jackery cloud credentials -----
# The same email/password you use in the Jackery mobile app.
JACKERY_EMAIL=you@example.com
JACKERY_PASSWORD=your-password-here

# Region: US | EU | CN  (default US). The cloud picks a different host per region.
JACKERY_REGION=US

# ----- OPTIONAL: dashboard port on the NAS -----
# Set this if 8000 is already used on your Synology (DSM, other apps, etc.).
JACKERY_HTTP_PORT=8000
